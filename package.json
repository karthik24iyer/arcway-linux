{
  "name": "arcway-desktop",
  "productName": "Arcway",
  "version": "2.1.1",
  "description": "Arcway desktop agent: run Claude, Codex, Copilot and Antigravity from your phone",
  "homepage": "https://github.com/karthik24iyer/arcway-relay-server",
  "author": "Arcway <app@arcway.local>",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "bash build.sh"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.arcway.app",
    "productName": "Arcway",
    "files": ["main.js", "preload.js", "renderer/**", "src/**", "assets/**"],
    "extraResources": [{ "from": "build/runtime", "to": "." }],
    "artifactName": "Arcway-${version}-${arch}.${ext}",
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "arcway-desktop",
      "synopsis": "Run coding agents on this computer from your phone"
    },
    "deb": {
      "depends": ["tmux", "libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0"]
    }
  }
}
